# docker compose also reads POSTGRES_PASSWORD from this file; keep it in sync with DATABASE_URL.
POSTGRES_PASSWORD=chatbot
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@db:5432/chatbot
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-secret

# --- LLM providers: set the keys for the providers you use ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default chat provider for tenants that haven't picked one: openai | anthropic | gemini
CHAT_PROVIDER=openai
# Optional; defaults: openai gpt-4.1-mini, anthropic claude-opus-5-5, gemini gemini-2.5-flash
CHAT_MODEL=

# Embeddings are shared by all tenants: openai | gemini.
# Changing provider, model or dimensions requires a fresh chunks table and re-uploading sources.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_DISTANCE=0.8
# Keyword search language: english (stems words) or simple (exact words; better for mixed languages).
# Changing it requires a fresh chunks table.
TEXT_SEARCH_CONFIG=english
# Rewrite follow-up questions into full questions before searching (one extra short model call).
QUERY_REWRITE=true
CHAT_RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=15
# Local OCR for scanned PDF pages and PNG/JPEG/TIFF/WebP knowledge uploads.
# Install matching Tesseract language data on every worker (Docker includes eng + hin).
OCR_LANGUAGES=eng+hin
OCR_MAX_PAGES=20
OCR_MAX_PIXELS=20000000
OCR_TIMEOUT_SECONDS=30

# --- WhatsApp Cloud API (Meta). Set the verify token and app secret for webhooks. The access token is an optional shared fallback. ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_SIGNUP_CONFIG_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_HANDOFF_KEYWORDS=human,agent

# Set false only for local HTTP development; keep true behind HTTPS in production.
AUTH_COOKIE_SECURE=true

# Transactional email: console for development; ses for delivery (see docs/EMAIL_DELIVERY.md).
EMAIL_BACKEND=console
EMAIL_FROM=notifications@marketingadda.com
EMAIL_REGION=ap-south-1
EMAIL_SNS_TOPIC_ARN=
EMAIL_CONFIGURATION_SET=
# Keep within the SES regional sending quota; shared across workers.
EMAIL_SENDS_PER_SECOND=1
PUBLIC_APP_URL=http://localhost:3000
# Contact CSV imports are validated atomically within these bounds.
CONTACT_IMPORT_MAX_BYTES=1048576
CONTACT_IMPORT_MAX_ROWS=1000
# Campaign audience cap, per-phone sends/second, and shared portfolio daily cap.
CAMPAIGN_MAX_RECIPIENTS=1000
CAMPAIGN_SENDS_PER_SECOND=1
CAMPAIGN_DAILY_LIMIT=250
# /dashboard/campaigns uses these existing worker budgets; no browser provider keys are needed.
# SES uses the AWS SDK credential chain. Prefer a worker IAM role; never commit credentials.
# MASTER_KEY is also required for SES, including development/staging.

# Storage: local for development, s3 for S3/R2/MinIO
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
STORAGE_BUCKET=chatbot-uploads
# WhatsApp files: images up to 5 MiB; audio/documents up to this limit (16 MiB maximum).
MEDIA_MAX_BYTES=16777216
MEDIA_RETENTION_DAYS=365
# Opt in after a measured Indian-language speech evaluation; reuse OPENAI_API_KEY.
TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Uses the workspace chat provider/model; enable only for a vision-capable model.
MEDIA_VISION_ENABLED=false
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY required for S3/MinIO.

# Envelope encryption (required when ENVIRONMENT=production).
# Generate: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENVIRONMENT=development
MASTER_KEY=
MASTER_KEY_VERSION=1
# JSON mapping of previous master-key versions to base64 keys during rotation.
MASTER_KEY_PREVIOUS={}

# Durable arq worker queue (Redis)
REDIS_URL=redis://redis:6379/0

# Optional Inbox Web Push. Generate with python -m scripts.generate_vapid --subject mailto:ops@example.com
# Set all three on the API and worker. Keep the private key out of Git.
INBOX_VAPID_PUBLIC_KEY=
INBOX_VAPID_PRIVATE_KEY=
INBOX_VAPID_SUBJECT=

# Minimum cosine similarity for a curated FAQ to take priority over documents.
QA_MIN_SIMILARITY=0.9

# Map provider:model to [input USD, output USD] per million tokens.
AI_PRICES_USD={}

# Enable subscriptions after configuring Razorpay test or live mode and a separate webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_IDS={}

# Enable GST invoices after accountant review. JSON fields: name, address, state,
# postal_code, gstin, sac, tax_rate. State is a two-digit GST place code.
GST_INVOICE_ISSUER=null
# Platform console access is granted through users.is_platform_admin in the database;
# ADMIN_BOOTSTRAP_TOKEN and workspace API keys do not grant platform access.
# Analytics: the existing arq worker rebuilds UTC reports daily at 01:10; no extra credentials.

# Observability: empty values disable the private scrape endpoint and external error reporting.
METRICS_TOKEN=
SENTRY_DSN=
# Browser Sentry DSN is a public routing key, read at web build time.
NEXT_PUBLIC_SENTRY_DSN=

# Maximum total reserved website pages per workspace; the plan may allow fewer.
CRAWL_PAGE_CAP=200

# Answer-review Q&A publication uses the existing arq worker and embedding provider; no extra credentials.

# Multilingual reply policy/notices use the existing chat provider; message overrides are stored per workspace.
# All admin catalogs support English/Hindi via a browser cookie; no locale environment setting is needed.
# Edit customer notice overrides in Bot settings; resetting a language restores its catalog defaults.

# Product-managed appointments use PostgreSQL and the existing worker; no new provider keys.
# Appointment reminder templates must be approved UTILITY text with {{1}} service, {{2}} staff, {{3}} time.
# Appointment reminder dispatch runs every 15 seconds; customer consent and current channel permissions are rechecked.
# Configure services, staff, slots and customer reminder consent in the Appointments screen (owner/admin/agent roles).

# Google Calendar OAuth (optional; absent credentials disable Connect).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_REQUESTS_PER_MINUTE=60

# Customer payments use encrypted per-workspace Razorpay keys, not platform billing keys.
PAYMENT_LINK_REQUESTS_PER_MINUTE=60

# Lead export Google OAuth; optional until a Google app is configured.
LEAD_SYNC_GOOGLE_CLIENT_ID=
LEAD_SYNC_GOOGLE_CLIENT_SECRET=
LEAD_SYNC_GOOGLE_REDIRECT_URI=
LEAD_SYNC_REQUESTS_PER_MINUTE=60

# Lead provider API pins; review quarterly before changing adapters.
LEAD_SYNC_HUBSPOT_API_VERSION=v3
LEAD_SYNC_ZOHO_API_VERSION=v8
LEAD_SYNC_SHEETS_API_VERSION=v4

# Accuracy runs: maximum questions per paid background run (1–200).
EVAL_MAX_CASES_PER_RUN=100

# Account authenticator app label; TOTP keys require MASTER_KEY.
TOTP_ISSUER=MarketingAdda

# Public API: fallback quota when the plan has no api_requests_per_minute limit.
PUBLIC_API_DEFAULT_REQUESTS_PER_MINUTE=60
PUBLIC_API_MAX_BODY_BYTES=1048576

# Outgoing webhooks: tenant destination count and shared delivery quota.
OUTGOING_WEBHOOK_MAX_ENDPOINTS=10
OUTGOING_WEBHOOK_REQUESTS_PER_MINUTE=60

# Custom HTTP actions: maximum definitions and shared tenant call quota.
HTTP_ACTION_LIMIT=20
HTTP_ACTION_REQUESTS_PER_MINUTE=60
