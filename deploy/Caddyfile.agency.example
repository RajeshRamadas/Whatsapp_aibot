# Merge with the primary Caddyfile. Preserve the canonical site's explicit host block.
{
    on_demand_tls {
        ask http://127.0.0.1:8088/api/v1/branding/domain
    }
}

https:// {
    tls {
        on_demand
    }
    forward_auth 127.0.0.1:8088 {
        uri /api/v1/branding/domain
        header_up X-Agency-Host {host}
    }
    @api path /health /widget.js /webhooks/* /api/v1/*
    handle @api {
        reverse_proxy 127.0.0.1:8088
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
