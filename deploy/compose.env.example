# Use a distinct project and immutable image tags for each environment and release.
COMPOSE_PROJECT_NAME=whatsapp-aibot-staging
APP_IMAGE=whatsapp-aibot-api:replace-with-release-sha
WEB_IMAGE=whatsapp-aibot-web:replace-with-release-sha
APP_ENV_FILE=app.env
API_PORT=8088
WEB_PORT=3000
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
