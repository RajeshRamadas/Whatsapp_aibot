# Copy to app.env and restrict it to the deployer. Use distinct staging and production services in India.
DATABASE_URL=postgresql+psycopg://chatbot:replace-with-password@postgres.example.invalid:5432/chatbot?sslmode=verify-full&sslrootcert=system
REDIS_URL=rediss://default:replace-with-password@redis.example.invalid:6379/0
PUBLIC_APP_URL=https://staging.example.invalid
ADMIN_BOOTSTRAP_TOKEN=
MASTER_KEY=
MASTER_KEY_VERSION=1
MASTER_KEY_PREVIOUS={}

STORAGE_BACKEND=s3
STORAGE_BUCKET=replace-with-private-bucket
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT_URL=
# Supply scoped AWS credentials through the host identity or deployment secret store.

# Set a separate secret for the private Prometheus scrape.
METRICS_TOKEN=
EMAIL_BACKEND=console
# Set a real email backend before enabling customer signups.
# See .env.example for LLM, Meta, billing, email and optional integration settings.
